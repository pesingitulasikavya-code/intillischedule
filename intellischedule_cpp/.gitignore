# IntelliSchedule .gitignore

# Build Directories & Artifacts
build/
bin/
out/
dist/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake
compile_commands.json

# Compiled Executables & Libraries
*.exe
*.out
*.app
*.so
*.dylib
*.dll
*.a
*.lib
*.obj
*.o

# SQLite Database Files & WAL logs
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# IDE & Editor Specific Folders
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Node.js Dependencies (for Full-Stack UI)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
